---
layout: layouts/base.njk
---
<section class="page-hero">
  <div class="page-hero__media">
    {% image heroImage, heroImageAlt, "100vw", "eager" %}
  </div>
  <div class="page-hero__scrim" aria-hidden="true"></div>
  <div class="page-hero__content">
    <p class="eyebrow">{{ pageSubtitle }}</p>
    <h1>{{ pageTitle }}</h1>
  </div>
</section>

<section class="section">
  <div class="container">
  <h2 class="visually-hidden">Ways To Get Involved</h2>
  <div class="card-grid card-grid--4">
    {% for card in cards %}
    <div class="card card--colored card--{{ card.color }}">
      <svg class="card__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        {% if card.icon == "clock" %}
        <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
        {% elif card.icon == "chat" %}
        <path d="M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-4 4v-4H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/>
        {% elif card.icon == "heart" %}
        <path d="M12 21s-7-4.5-9-9a5.5 5.5 0 0 1 9-6 5.5 5.5 0 0 1 9 6c-2 4.5-9 9-9 9Z"/>
        {% elif card.icon == "gift" %}
        <rect x="3" y="8" width="18" height="13" rx="1"/><path d="M3 8h18M12 8v13M12 8c-1.5-4-6-4-6 0M12 8c1.5-4 6-4 6 0"/>
        {% endif %}
      </svg>
      {% if card.linkUrl %}
      <h3><a href="{{ card.linkUrl }}" rel="noopener" target="_blank">{{ card.title }}</a></h3>
      {% else %}
      <h3>{{ card.title }}</h3>
      {% endif %}
      <p>{{ card.description }}</p>
    </div>
    {% endfor %}
  </div>
  </div>
</section>

<section class="cta-banner">
  <div class="container">
    <h2>{{ ctaHeading }}</h2>
    <a class="button" href="{{ site.churchsuite.connectForm }}" rel="noopener" target="_blank">{{ ctaButtonText }}</a>
  </div>
</section>
