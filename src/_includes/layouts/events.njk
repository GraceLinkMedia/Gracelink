---
layout: layouts/base.njk
---
<div class="page-header">
  <h1>{{ pageTitle }}</h1>
  <p>{{ pageSubtitle }}</p>
</div>

<section class="section">
  <div class="container prose" style="text-align: center; max-width: 60ch; margin-inline: auto;">
    <p>{{ intro }}</p>
  </div>
  <div class="container" style="margin-top: var(--space-5);">
    <iframe
      src="{{ calendarEmbedUrl }}"
      title="GraceLink Church events calendar"
      width="100%"
      height="800"
      frameborder="0"
      loading="lazy"
      style="border: 0; max-width: 100%; display: block;"
    ></iframe>
    <p style="text-align: center; margin-top: var(--space-3);">
      <a class="button button--outline" href="{{ site.churchsuite.portal }}" rel="noopener" target="_blank">{{ buttonText }}</a>
    </p>
  </div>
</section>
