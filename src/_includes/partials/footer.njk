<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" aria-label="{{ site.name }} — Home">
        {% image "assets/images/footer-logo-white.png", "", "56px" %}
      </a>
      <p>{{ site.venue.display }}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {% for item in nav %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <div class="site-footer__contact">
      <p>
        <a href="{{ site.phoneHref }}">{{ site.phone }}</a><br>
        <a href="mailto:{{ site.email | replace('@', '&#64;') | safe }}">{{ site.email | replace('@', '&#64;') | safe }}</a>
      </p>
      <p>{{ site.service.display }}</p>
      <ul class="site-footer__social">
        <li>
          <a href="{{ site.social.facebook }}" aria-label="GraceLink Church on Facebook" rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
          </a>
        </li>
        <li>
          <a href="{{ site.social.instagram }}" aria-label="GraceLink Church on Instagram" rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.8.2 2.3.4a4.6 4.6 0 0 1 2.6 2.6c.2.5.4 1.2.4 2.3.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.8-.4 2.3a4.6 4.6 0 0 1-2.6 2.6c-.5.2-1.2.4-2.3.4-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.8-.2-2.3-.4a4.6 4.6 0 0 1-2.6-2.6c-.2-.5-.4-1.2-.4-2.3C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.8.4-2.3a4.6 4.6 0 0 1 2.6-2.6c.5-.2 1.2-.4 2.3-.4C8.9 2 9.3 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2A3.2 3.2 0 1 1 12 8.8a3.2 3.2 0 0 1 0 6.4Zm5.2-8.4a1.2 1.2 0 1 1 0-2.4 1.2 1.2 0 0 1 0 2.4Z"/></svg>
          </a>
        </li>
        <li>
          <a href="{{ site.social.youtube }}" aria-label="GraceLink Church on YouTube" rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2s-.2-1.5-.8-2.2c-.8-.8-1.7-.8-2.1-.9C15.9 4 12 4 12 4h0s-3.9 0-6.7.1c-.4 0-1.3.1-2.1.9-.6.7-.8 2.2-.8 2.2S2.2 9 2.2 10.7v1.5c0 1.7.2 3.5.2 3.5s.2 1.5.8 2.2c.8.8 1.9.8 2.3.9 1.7.2 7 .2 7 .2s3.9 0 6.7-.2c.4 0 1.3-.1 2.1-.9.6-.7.8-2.2.8-2.2s.2-1.7.2-3.5v-1.5C22 9 21.8 7.2 21.8 7.2ZM9.9 14.6V8.9l5.4 2.9-5.4 2.8Z"/></svg>
          </a>
        </li>
        <li>
          <a href="{{ site.social.google }}" aria-label="GraceLink Church on Google" rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.8 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.5a4.7 4.7 0 0 1-2 3.1v2.6h3.3c1.9-1.8 3-4.4 3-7.5Z"/><path d="M12 22c2.7 0 5-.9 6.7-2.4l-3.3-2.6c-.9.6-2.1 1-3.4 1-2.6 0-4.9-1.8-5.7-4.2H2.9v2.6A10 10 0 0 0 12 22Z"/><path d="M6.3 13.8a6 6 0 0 1 0-3.6V7.6H2.9a10 10 0 0 0 0 8.8l3.4-2.6Z"/><path d="M12 5.8c1.5 0 2.8.5 3.8 1.5l2.8-2.8A9.6 9.6 0 0 0 12 2a10 10 0 0 0-9.1 5.6l3.4 2.6c.8-2.4 3.1-4.4 5.7-4.4Z"/></svg>
          </a>
        </li>
        {% if site.social.tiktok %}
        <li>
          <a href="{{ site.social.tiktok }}" aria-label="GraceLink Church on TikTok" rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-3.3v13.5a2.7 2.7 0 1 1-2.1-2.6V9.5a6 6 0 1 0 5.4 6V8.4a7.7 7.7 0 0 0 4.4 1.4V6.5a4.4 4.4 0 0 1-4.4-4.4V2Z"/></svg>
          </a>
        </li>
        {% endif %}
      </ul>
    </div>
  </div>

  <div class="container site-footer__copyright">
    &copy; {{ "now" | year }} {{ site.name }}. Charity No. {{ site.charityNumber }}
  </div>
</footer>
